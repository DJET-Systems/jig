#!/usr/bin/make -f
# Build with Ninja and a Release profile; PPA builds come from the sealed tarball.
%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -G Ninja -DCMAKE_BUILD_TYPE=Release

# dh_auto_test runs ctest for the cmake buildsystem; nothing to override.
override_dh_auto_test:
	dh_auto_test
